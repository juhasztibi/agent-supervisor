preview() { # <task|agent>: the live view shown next to the Running agents list
  local task="${1%%|*}" role="${1#*|}" p d changes u tk k m e
  use_task "$task"; p=$(agent_pane "$role"); d=$(wt_dir "$role")
  if [[ -d "$d" ]]; then
    changes=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    printf '%s\n' "${C_BOLD}$(agent_name "$role")${C_RESET}  ${C_DIM}branch $(git -C "$d" branch --show-current 2>/dev/null) · $changes changed files${C_RESET}"
    read -r u tk k m e <<< "$(agent_usage "$d")"
    [[ "$tk" -gt 0 ]] && printf '%s\n' "${C_DIM}$(model_short "$m")$([[ "$e" != - ]] && echo " · effort $e" || true) · $(tokens_short "$tk") tokens · $(money "$u" "$(usd_rate)")$([[ $k -gt 0 ]] && echo " + $k replies without a known price" || true)${C_RESET}"
  fi
  if [[ -z "$p" ]]; then echo "No pane yet."; return 0; fi
  is_running "$role" || printf '%s\n' "${C_YELLOW}stopped: the pane is a shell${C_RESET}"
  echo
  tmux capture-pane -p -e -J -t "$p" | awk '{ lines[NR] = $0; if ($0 ~ /[^[:space:]]/) last = NR } END { for (i = 1; i <= last; i++) print lines[i] }'
}

with_timeout() { # <seconds> <command...>: runs it, killing it when it takes longer
  local secs="$1" pid watcher rc=0; shift
  "$@" & pid=$!
  ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 & watcher=$!
  wait "$pid" 2>/dev/null || rc=$?
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true   # reaps it quietly: no "Terminated" line on screen
  return $rc
}
claude_line() { # who Claude Code is logged in as; cached for the menu session in $AA_AUTH
  local j email org plan exp days ver line
  if [[ -n "${AA_AUTH:-}" && -s "$AA_AUTH" ]]; then cat "$AA_AUTH"; return 0; fi
  j=$(with_timeout 5 claude auth status 2>/dev/null || true)
  ver=$(with_timeout 5 claude --version 2>/dev/null | awk '{ print $1 }' || true)
  if [[ -z "$j" ]]; then printf '%s' "${C_YELLOW}couldn't read the login (claude auth status gave no answer)${C_RESET}"; return 0; fi
  if ! grep -q '"loggedIn": *true' <<< "$j"; then
    line="${C_RED}${C_BOLD}not logged in${C_RESET} · agents can't start until you run: claude auth login"
  else
    field() { sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p" <<< "$j" | head -n 1; }
    email=$(field email); org=$(field orgName); plan=$(field subscriptionType); exp=$(field loginExpiresAt)
    line="$email${org:+ · $org}${plan:+ · $plan plan}"
    if [[ -n "$exp" ]]; then
      days=$(( ( $(date -j -u -f '%Y-%m-%dT%H:%M:%S' "${exp%%.*}" +%s 2>/dev/null || date +%s) - $(date +%s) ) / 86400 ))
      if [[ $days -lt 7 ]]; then line+=" · ${C_YELLOW}login ends in $(plural "$days" day)${C_RESET}"
      else line+=" · ${C_DIM}login valid $(plural "$days" day)${C_RESET}"; fi
    fi
  fi
  line+="${ver:+ · ${C_DIM}Claude Code $ver${C_RESET}}"
  [[ -n "${AA_AUTH:-}" ]] && printf '%s' "$line" > "$AA_AUTH"
  printf '%s' "$line"
}

git_counts() { # <worktree>: "<changed files> <commits not on the default branch> <current branch>"
  local n=0 c=0 base br
  n=$(git -C "$1" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if base=$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
    c=$(git -C "$1" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
  fi
  br=$(git -C "$1" branch --show-current 2>/dev/null || true)
  echo "${n:-0} ${c:-0} ${br:--}"
}
dashboard() { # [full|monitor]: the overview above the main menu; monitor keeps only the task numbers
  local mode="${1:-full}" gone t r st line f a b br prs merged gitdir u tk k m e tusd ttok tunk models rate allusd=0 alltok=0 open="" closed="" w=8 dps n_work=0 n_need=0 n_idle=0 n_stop=0 ch n base d dc dmine=0 dall parts lines="" i=0
  pr_refresh_if_old
  rate=$(usd_rate)
  dps=$(docker ps --format '{{.Label "com.docker.compose.project.working_dir"}}|{{.Label "com.docker.compose.project"}}' 2>/dev/null) || dps="off"
  for t in $(all_tasks); do
    use_task "$t"
    if session_exists; then open+="$t "; [[ ${#t} -gt $w ]] && w=${#t}; else closed+="$t "; fi
  done
  gitdir=$(mktemp -d "${TMPDIR:-/tmp}/$PROG.git.XXXXXX")
  for t in $open; do   # git is the slow part: count changes and commits of every worktree at once
    use_task "$t"
    for r in $(task_roles); do
      (git_counts "$(wt_dir "$r")" > "$gitdir/$t.$r") &
      (agent_usage "$(wt_dir "$r")" > "$gitdir/$t.$r.use") &
    done
  done
  wait
  for t in $open; do
    use_task "$t"; line="$(printf "%-${w}s" "$t")  "
    for r in $(known_roles); do
      st=$(agent_state "$r")
      case "$st" in working) n_work=$((n_work + 1)) ;; needs-you) n_need=$((n_need + 1)) ;; idle) n_idle=$((n_idle + 1)) ;; *) n_stop=$((n_stop + 1)) ;; esac
      line+="$(dot "$r" word "$st")  "
    done
    ch=0; prs=""; tusd=0; ttok=0; tunk=0; models=""
    for r in $(task_roles); do
      a=0; b=0; br="$t"; [[ -f "$gitdir/$t.$r" ]] && read -r a b br < "$gitdir/$t.$r"
      ch=$((ch + a)); prs+=$(pr_label "$r" "$br" "$b")
      u=0; tk=0; k=0; m=-; e=-; [[ -f "$gitdir/$t.$r.use" ]] && read -r u tk k m e < "$gitdir/$t.$r.use"
      tusd=$(awk -v a="$tusd" -v b="$u" 'BEGIN { printf "%.6f", a + b }'); ttok=$((ttok + tk)); tunk=$((tunk + k))
      [[ "$m" != - ]] && models+="$r|$(model_short "$m")${e:+ $([[ "$e" != - ]] && echo "$e" || true)}"$'\n'
    done
    allusd=$(awk -v a="$allusd" -v b="$tusd" 'BEGIN { printf "%.6f", a + b }'); alltok=$((alltok + ttok))
    dc=0
    [[ "$dps" == off ]] || dc=$(awk -F'|' -v d="$WT_ROOT/$t/" -v p="$S" 'index($1 "/", d) == 1 || $2 == p' <<< "$dps" | grep -c . || true)
    dmine=$((dmine + dc))
    line+="${C_DIM}$(plural "$ch" "changed file")${C_RESET}"
    if [[ $ttok -gt 0 ]]; then
      line+=" · $(tokens_short "$ttok") tokens · ${C_BOLD}$(money "$tusd" "$rate")${C_RESET}$([[ $tunk -gt 0 ]] && echo "${C_DIM}+?${C_RESET}" || true)"
      line+=" · ${C_DIM}$(model_list "$models")${C_RESET}"
    fi
    line+="$prs$([[ $dc -gt 0 ]] && echo "${C_DIM} · $(plural "$dc" container)${C_RESET}" || true)"
    i=$((i + 1)); [[ $i -le 8 ]] && lines+="$line"$'\n'
  done
  rm -rf "$gitdir"
  [[ $i -gt 8 ]] && lines+="${C_DIM}… and $((i - 8)) more open tasks under 2 Running agents${C_RESET}"$'\n'

  local others; others=$(other_orgs_open)
  [[ "$mode" == full ]] && printf '%s\n' "${C_BOLD}GitHub ${C_RESET}  ${C_BOLD}$ORG${C_RESET}${C_DIM} · o: switch${others:+ · also open: $others}${C_RESET}"
  [[ "$mode" == full ]] && printf '%s\n' "${C_BOLD}Claude ${C_RESET}  $(claude_line)"
  parts=""
  [[ $n_need -gt 0 ]] && parts+="${C_YELLOW}${C_BOLD}$n_need $([[ $n_need -eq 1 ]] && echo needs || echo need) you${C_RESET} · "
  [[ $n_work -gt 0 ]] && parts+="${C_GREEN}$n_work working${C_RESET} · "
  [[ $n_idle -gt 0 ]] && parts+="$n_idle idle · "
  [[ $n_stop -gt 0 ]] && parts+="${C_DIM}$n_stop stopped${C_RESET} · "
  [[ "$mode" == full ]] && printf '%s\n' "${C_BOLD}Agents ${C_RESET}  ${parts:-${C_DIM}none running · }$(plural "$(count $open)" "open task")$([[ -n "$closed" ]] && echo " · $(count $closed) not open" || true)"
  if [[ $alltok -gt 0 ]]; then
    printf '%s\n' "${C_BOLD}Cost   ${C_RESET}  ${C_BOLD}$(money "$allusd" "$rate")${C_RESET} for $(tokens_short "$alltok") tokens on open tasks ${C_DIM}· estimate at API list prices, not your bill$([[ -n "$rate" ]] && echo " · 1 USD = $(awk -v r="$rate" 'BEGIN { printf "%.3f", r }') $CURRENCY" || true)${C_RESET}"
  fi
  if [[ "$mode" != full ]]; then :
  elif [[ "$dps" == off ]]; then printf '%s\n' "${C_BOLD}Docker ${C_RESET}  ${C_DIM}not running${C_RESET}"
  else
    dall=$(grep -c . <<< "$dps" || true)
    printf '%s\n' "${C_BOLD}Docker ${C_RESET}  $(plural "$dall" container) running · $dmine from these tasks"
  fi
  [[ "$mode" == full ]] && printf '%s\n' "${C_BOLD}Default${C_RESET}  ${C_DIM}Remote Control $REMOTE · layout $DEFAULT_LAYOUT · opens in: $DEFAULT_OPEN · $(plural "$(count $(all_roles))" agent) you can start${C_RESET}"
  if [[ -n "$lines" ]]; then printf '\n%s' "$lines"; fi
  if [[ "$mode" == full && -n "$closed" ]]; then
    printf '%s\n' "${C_DIM}Not open: $(echo $closed | tr ' ' '\n' | head -n 4 | paste -sd, - | sed 's/,/, /g')$([[ $(count $closed) -gt 4 ]] && echo ", …" || true) · 3 resumes them${C_RESET}"
  fi
  gone=$(closed_unexpectedly)
  [[ "$mode" == full && -n "$gone" ]] && printf '%s\n' "${C_YELLOW}Closed unexpectedly (Mac restart?): $(csv "$gone" | sed 's/,/, /g') · 3 resumes them all${C_RESET}"
  merged=$(merged_tasks)
  [[ -n "$merged" ]] && printf '%s\n' "${C_GREEN}Merged and clean: $(csv "$merged" | sed 's/,/, /g') · 5 removes them${C_RESET}"
  [[ "$mode" == full ]] && printf '%s\n' "${C_DIM}Updated $(date +%H:%M:%S), every 10 seconds$([[ -f "$ORG_CACHE/prs.tsv" ]] && echo " · pull requests from $(stat -f %Sm -t %H:%M "$ORG_CACHE/prs.tsv")" || true) · r: refresh now${C_RESET}"
  return 0
}
model_list() { # lines "agent|Model effort": one "Opus 5.5 medium" when all agree, else "be Opus 5.5 medium, ui Sonnet 5.5 high"
  local uniq
  uniq=$(printf '%s' "$1" | cut -d'|' -f2 | sort -u)
  if [[ $(printf '%s\n' "$uniq" | grep -c .) -le 1 ]]; then printf '%s' "$uniq"
  else printf '%s' "$1" | awk -F'|' 'NF == 2 { printf "%s%s %s", (n++ ? ", " : ""), $1, $2 }'; fi
}
pr_label() { # <agent> <branch> <commits>: " · be #123 ✓ checks pass" and the like
  local pr n st ck c
  pr=$(pr_of "$1" "$2")
  if [[ -z "$pr" ]]; then
    [[ "${3:-0}" -gt 0 ]] && printf '%s' " · ${C_DIM}$1: $(plural "$3" commit), no PR${C_RESET}"
    return 0
  fi
  read -r n st ck <<< "$pr"
  case "$st" in
    MERGED) printf '%s' " · ${C_GREEN}$1 #$n merged${C_RESET}" ;;
    CLOSED) printf '%s' " · ${C_DIM}$1 #$n closed${C_RESET}" ;;
    *) case "$ck" in
         pass)    c="${C_GREEN}✓ checks pass" ;;
         fail)    c="${C_RED}✗ checks fail" ;;
         pending) c="${C_YELLOW}… checks running" ;;
         *)       c="${C_DIM}no checks" ;;
       esac
       printf '%s' " · $1 #$n $c${C_RESET}" ;;
  esac
}
main_header() { # dashboard, then the menu title
  local shown=""
  [[ -n "${AA_SHOWN:-}" && -s "$AA_SHOWN" ]] && shown="$(cat "$AA_SHOWN")"$'\n'"${C_DIM}────────${C_RESET}"$'\n'
  local dash
  if [[ "${1:-}" == cached && -n "${AA_DASH:-}" && -s "$AA_DASH" ]]; then dash=$(cat "$AA_DASH")   # instant; the live refresh follows at once
  else dash=$(dashboard); [[ -n "${AA_DASH:-}" ]] && printf '%s' "$dash" > "$AA_DASH"; fi
  printf '%s%s\n\n%s\n%s\n' "$shown" "$dash" "${C_BOLD}What do you want to do?${C_RESET}" "${C_DIM}m: monitor · o: organisation · 1-8: jump · Enter: choose · r: refresh · q: quit${C_RESET}"
}

interactive() { # [monitor]
  command -v fzf >/dev/null || die "the menu needs fzf: brew install fzf"
  command -v tmux >/dev/null || die "the menu needs tmux: brew install tmux"
  [[ -t 0 && -t 1 ]] || die "the menu needs a terminal; see: $PROG help"
  local choice
  NOTES=$(mktemp "${TMPDIR:-/tmp}/$PROG.XXXXXX")
  export AA_AUTH="$NOTES.auth" AA_SHOWN="$NOTES.shown" AA_DASH="$NOTES.dash" AA_COLOR=1   # the live header renders in a child process
  FZF_API_KEY=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n'); export FZF_API_KEY   # only our refresh loop may talk to fzf
  : > "$AA_SHOWN"
  trap 'rm -f "$NOTES" "$NOTES".*' EXIT
  if [[ -n "$ORG_FROM_ENV" || ( "${1:-}" == monitor && -n "$ORG" ) ]]; then org_watchdogs
  else flow_org quit || { top; return 0; }; fi
  if [[ "${1:-}" == monitor ]]; then flow_monitor; top; return 0; fi   # the monitor on its own, e.g. in a side pane
  while :; do
    load_repos
    if [[ -s "$NOTES" ]]; then cat "$NOTES" > "$AA_SHOWN"; : > "$NOTES"; fi   # the last result stays above the overview
    if [[ -z "${AA_DASH:-}" || ! -s "$AA_DASH" ]]; then
      loading "Loading the overview of ${ORG}" "Agents, costs, pull requests and Docker"; main_header > /dev/null; loaded
    fi
    live 10 "bg-transform-header($SELF _header)"
    choice=$(printf '%s\n' "start${TAB}1  Start new agents" "running${TAB}2  Running agents" \
      "resume${TAB}3  Resume agents" "repo${TAB}4  Add a repository" "remove${TAB}5  Remove agents" "tools${TAB}6  Skills, plugins and MCP servers" "monitor${TAB}7  Monitor: what every agent is doing" "org${TAB}8  Switch GitHub organisation" "quit${TAB}   Quit" |
      PICK_HEADER="$(main_header cached)" NO_BACK=1 pick "" "" --no-input "${LIVE[@]}" \
        --bind "r:bg-transform-header($SELF _header)" --bind 'esc:ignore,q:abort,j:down,k:up,1:pos(1)+accept,2:pos(2)+accept,3:pos(3)+accept,4:pos(4)+accept,5:pos(5)+accept,6:pos(6)+accept,7:pos(7)+accept,m:pos(7)+accept,8:pos(8)+accept,o:pos(8)+accept') || break
    : > "$AA_SHOWN"
    case "$choice" in
      start)   flow_start ;;
      running) flow_running ;;
      resume)  flow_resume ;;
      repo)    flow_add_repo ;;
      remove)  flow_remove ;;
      tools)   flow_inventory ;;
      monitor) flow_monitor ;;
      org)     flow_org "back" && : > "$AA_DASH" || true ;;
      quit)    break ;;
    esac
  done
  top; [[ -s "$NOTES" ]] && cat "$NOTES"; return 0   # leave the last result on screen
}

usage="usage: $PROG [--org owner] (no arguments: interactive menu) | orgs | org [owner] | up <task> [goal] [--only a,b] [--split|--own] [--remote on|off] [--window|--tab|--here|--detached] | start <task> a[,b] [--split|--own] [--fresh] [--remote on|off] [open] | stop <task> a[,b] | resume <task> [--only a,b] [--split|--own] [--fresh] [--remote on|off] [open] | attach <task> [open] | say <task> <agent> <msg> | ls | repos | add-repo <repo|path> [agent] [description] | remove <task> a[,b] [--force] | down <task> [--prune] | help"
main() {
  if [[ "${1:-}" == --org ]]; then [[ -n "${2:-}" ]] || die "--org needs a GitHub owner"; AA_ORG="$2"; ORG_FROM_ENV="$2"; shift 2; fi
  resolve_org
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    ""|menu|monitor|help|-h|--help|selftest|orgs|org|_ticker|_feed|_spin|_inv|inventory|_usage|_activity|_hook|_notify) ;;
    *) need_org ;;
  esac
  case "$cmd" in
    "")
      if [[ -t 0 && -t 1 && -z "${CLAUDECODE:-}" ]]; then interactive; else die "$usage"; fi ;;
    menu) interactive ;;
    monitor) interactive monitor ;;
    monitor-pane) monitor_pane "${1:-}" ;;
    _monitor) monitor_lines ;;
    _monitor_header) monitor_header ;;
    help|-h|--help) sed -n '2,/^set -euo/p' "$SELF" | sed -e '$d' -e 's/^# \{0,1\}//' ;;
    up|resume|attach|down)
      check_task "${1:-}"; use_task "$1"; shift; parse "$@"
      case "$cmd" in up) up ;; resume) resume ;; attach) open_view "${OPEN:-here}" ;; down) down ;; esac ;;
    start|stop|say|remove|restart)
      check_task "${1:-}"; use_task "$1"
      if [[ "$cmd" == say && "${2:-}" == all ]]; then ROLES=$(known_roles); ROLES="${ROLES% }"; [[ -n "$ROLES" ]] || die "task $TASK has no agents"
      else ROLES=$(check_roles "${2:-}"); fi
      shift 2
      if [[ "$cmd" == say ]]; then
        [[ $# -ge 1 ]] || die "usage: $PROG say <task> <agent>|a,b|all \"message\""; GOAL="$*"
      else parse "$@"; fi
      case "$cmd" in start) start ;; stop) stop ;; say) say ;; remove) remove ;; restart) restart ;; esac ;;
    ls) list ;;
    repos) repos ;;
    add-repo) add_repo_cmd "$@" ;;
    orgs)     owner_lines | while IFS=$'\t' read -r o d; do printf '%s %-24s %s\n' "$([[ "$o" == "$ORG" ]] && echo '*' || echo ' ')" "$o" "$d"; done ;;
    org)      if [[ -n "${1:-}" ]]; then use_org "$1"; remember_org; echo "commands now work in $ORG"; else need_org; echo "$ORG"; fi ;;
    _preview) preview "${1:-}" ;;
    _header)  main_header ;;
    _notify)  notify "$@" ;;
    _hook)    hook "$@" >/dev/null 2>&1 </dev/stdin || true ;;
    _watch)   watch "${1:?task}" ;;
    _usage)    agent_usage "${1:?worktree}" ;;
    _activity) activity_of "${1:?worktree}" ;;
    _state)   check_task "${1:-}"; use_task "$1"; agent_state "${2:?agent}" ;;
    resume-all) parse "$@"; resume_all ;;
    selftest) exec bash "${AA_TESTS:-$(dirname "$(readlink -f "$SELF")")/tests.sh}" "$SELF" ;;   # tests.sh sits next to the real file
    _prs)     pr_refresh ;;
    _ticker)  ticker "$@" ;;
    _feed)    feed "$@" ;;
    _spin)    spin "$@" ;;
    _agents)  agents_lines ;;
    save-choice) check_task "${1:-}"; use_task "$1"; ROLES=$(check_roles "${2:-}"); shift 2; parse "$@"; save_choices "$ROLES" ;;
    _inv)     inv_preview "${1:-}" ;;
    inventory) inventory ;;
    prs)      pr_refresh; cat "$ORG_CACHE/prs.tsv" 2>/dev/null || true ;;
    *)  die "$usage" ;;
  esac
}

# one line, so editing this file while a menu is open never makes the running copy read new text
main "$@"; exit $?
